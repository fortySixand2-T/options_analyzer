# API authentication (protects order and mutating endpoints)
API_SECRET_KEY=

# JWT authentication (user login)
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# Tastytrade (required for live data, free with funded account)
TT_USERNAME=
TT_PASSWORD=

# Alpaca (optional, for historical options backfill)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# ThetaData (optional, for historical backfill via Theta Terminal)
# Theta Terminal must be running on host: java -jar ThetaTerminal.jar
THETADATA_URL=http://host.docker.internal:25503

# FlashAlpha (optional, free tier: 5 calls/day)
FLASHALPHA_API_KEY=

# AI narrative (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SYNTHESIS_PROVIDER=anthropic

# Fund parameters
OPTIONS_FUND_SIZE=10000
OPTIONS_MAX_RISK_PCT=0.02
OPTIONS_MAX_POSITIONS=5

# Scanner defaults
OPTIONS_RISK_FREE_RATE=0.045
OPTIONS_MC_PATHS=5000
OPTIONS_MC_STEPS=252
OPTIONS_MC_SEED=42
SCANNER_MIN_DTE=0
SCANNER_MAX_DTE=14
SCANNER_SCORE_THRESHOLD=60

# Underlyings watchlist
SCANNER_WATCHLIST=SPX,SPY,QQQ,IWM,NVDA,TSLA

# ── Notifications ──────────────────────────────────────────────────────────────
# Webhooks are registered per-user via POST /api/user/webhooks.
# The variables below are optional convenience defaults for the first user / dev.

# Discord — create a webhook in Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Slack — create an Incoming Webhook at api.slack.com/apps → Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# Telegram — two steps:
#   1. Message @BotFather on Telegram → /newbot → copy the token it gives you
#   2. Send any message to your new bot, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy the "chat":{"id": ...} value
# TELEGRAM_BOT_TOKEN=123456:ABCdef...
# TELEGRAM_CHAT_ID=987654321

# Database paths (defaults work out of the box; override for custom locations)
# AUTH_DB_PATH=data/users.db

# Environment (set to "production" to enforce strong JWT_SECRET_KEY)
# ENV=development
