# API authentication (protects order and mutating endpoints)
API_SECRET_KEY=

# Tastytrade (required for live data, free with funded account)
TT_USERNAME=
TT_PASSWORD=

# Alpaca (optional, for historical options backfill)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# ThetaData (optional, for historical backfill via Theta Terminal)
# Theta Terminal must be running on host: java -jar ThetaTerminal.jar
THETADATA_URL=http://host.docker.internal:25503

# FlashAlpha (optional, free tier: 5 calls/day)
FLASHALPHA_API_KEY=

# AI narrative (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SYNTHESIS_PROVIDER=anthropic

# Fund parameters
OPTIONS_FUND_SIZE=10000
OPTIONS_MAX_RISK_PCT=0.02
OPTIONS_MAX_POSITIONS=5

# Scanner defaults
OPTIONS_RISK_FREE_RATE=0.045
OPTIONS_MC_PATHS=5000
OPTIONS_MC_STEPS=252
OPTIONS_MC_SEED=42
SCANNER_MIN_DTE=0
SCANNER_MAX_DTE=14
SCANNER_SCORE_THRESHOLD=60

# Underlyings watchlist
SCANNER_WATCHLIST=SPX,SPY,QQQ,IWM,NVDA,TSLA
